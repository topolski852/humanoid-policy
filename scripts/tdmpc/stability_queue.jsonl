# TD-MPC2 STABILITY search (omnidirectional). Run by supervisor.py with:
#   --queue scripts/tdmpc/stability_queue.jsonl --run_tag stability --grade_plant baseline
#   --grade_objective stability --min_judge_steps 9000000  (let each run finish its budget)
# Each spec warm-starts the bootstrapped walker (walk_win_0.924) via bootstrap.py --init_checkpoint,
# re-seeds omnidirectional PPO walk (--varied_commands), pretrains briefly, then online-refines with
# a STABILITY reward. Graded on the omnidirectional stability fitness (command-tracking * IMU-quietness).
# BROAD phase: each experiment isolates ONE stability lever (all keep omnidirectional tracking ON via
# track_lin_vel_xy + track_ang_vel_z). The advisor NARROWS later (combines winners, tunes weights).
# Supervisor auto-adds --variant --num_envs 32 --tdmpc2_square --compile --updates_per_step 16
#   --max_env_steps <spec> --seed 0 --headless --init_checkpoint <walker>.
{"name": "stab-A-track", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5}, "notes": "BASELINE omni: turn on command-vector tracking only (no quietness penalties). How clean is the gait from tracking alone across directions?"}
{"name": "stab-B-gyro", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5, "rewards.ang_vel_xy_l2.weight": -0.05}, "notes": "LEVER: torso roll/pitch gyro penalty (ang_vel_xy -0.05). Does quieting the gyro cut off-command rocking without hurting tracking?"}
{"name": "stab-C-level", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5, "rewards.flat_orientation_l2.weight": -0.3}, "notes": "LEVER: torso-level penalty (flat_orientation -0.3, the strongest term in the PPO walk). Keeps the torso upright/level through the gait."}
{"name": "stab-D-novert", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5, "rewards.lin_vel_z_l2.weight": -0.1}, "notes": "LEVER: vertical-bob penalty (lin_vel_z -0.1). Attacks the up/down IMU bounce directly."}
{"name": "stab-E-smooth", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5, "rewards.base_accel_xy_l2.weight": -0.05, "rewards.action_rate_l2.weight": -0.03}, "notes": "LEVER: smoothness/jerk (base_accel_xy -0.05 + action_rate -0.03). Cuts high-frequency IMU accel and twitchy actions."}
{"name": "stab-F-fullstack", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 2000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 1.0, "rewards.track_ang_vel_z.weight": 0.5, "rewards.ang_vel_xy_l2.weight": -0.05, "rewards.lin_vel_z_l2.weight": -0.1, "rewards.flat_orientation_l2.weight": -0.3, "rewards.base_accel_xy_l2.weight": -0.05, "rewards.action_rate_l2.weight": -0.03}, "notes": "ALL levers at once (the StandRewardsCfg/PPO-proven stability stack). The 'everything on' reference; the advisor narrows from whichever single levers + this help most."}
{"name": "stab-G-track4x", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0}, "notes": "TRACKING RECOVERY: broad phase found the omni refine COLLAPSES the gait (all 4 runs start 0.48 m/s -> decay to ~0.1; return rises as speed falls -> standing beats tracking at track weight 1.0). 4x tracking authority (lin 4.0/ang 2.0), 5M steps. Does the gait survive omni commands when tracking dominates?"}
{"name": "stab-H-track6x", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 6.0, "rewards.track_ang_vel_z.weight": 3.0}, "notes": "TRACKING RECOVERY (stronger): lin 6.0/ang 3.0, 5M. Brackets G to find how much tracking authority is needed to hold the gait. If G already tracks well, H tells us the ceiling before overshoot."}
{"name": "stab-I-track4x-level", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.flat_orientation_l2.weight": -0.3}, "notes": "TRACKING RECOVERY + first quietness lever: 4x tracking (as G) plus torso-level penalty (flat_orientation -0.3, the PPO-proven strongest term). Tests whether a single quietness lever can ride on top of restored tracking without re-collapsing the gait."}
{"name": "stab-J-track4x-10M", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 10000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0}, "notes": "TRACKING RECOVERY, longer budget: same as G (lin 4.0/ang 2.0) but 10M steps. If 5M is still improving on tracking, this gives the base omni gait room to fully consolidate before we layer quietness."}
{"name": "stab-K-nostand", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.upright_bonus.weight": 0.0, "rewards.stand_walk.params.move_weight": 0.95}, "notes": "REMOVE STANDING ATTRACTOR: A-G all collapse the warm gait to ~0.1 m/s because standing upright reliably banks upright_bonus(0.3)+stand_walk baseline(0.25) while omni tracking/feet_air_time give no gradient from a forward-only prior. Here upright_bonus->0 and stand_walk move_weight 0.75->0.95 (standing earns ~0), so the ONLY way to score is to move-and-track. Keeps 4x tracking. Does the gait survive when standing stops paying?"}
{"name": "stab-L-nostand-mild", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.upright_bonus.weight": 0.1, "rewards.stand_walk.params.move_weight": 0.9}, "notes": "MILDER anti-standing bracket for K: keep a small upright gradient (0.1) so the torso stays vertical, standing baseline cut to 0.10 (move_weight 0.9). If K holds the gait but drifts off-upright, L is the safer setpoint; if K over-suppresses standing and destabilizes, L brackets it."}
{"name": "stab-M-nostand-step", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.upright_bonus.weight": 0.0, "rewards.stand_walk.params.move_weight": 0.95, "rewards.feet_air_time.weight": 2.5}, "notes": "ANTI-STANDING + active stepping drive: as K but feet_air_time 1.5->2.5 to positively reward taking real steps (upright-gated), pushing the policy off the frozen basin toward an actual omni gait. Tests whether a stronger stride reward + no standing payoff together restore tracking."}
{"name": "stab-N-nostand-10M", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 10000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.upright_bonus.weight": 0.0, "rewards.stand_walk.params.move_weight": 0.95}, "notes": "ANTI-STANDING at LONG budget (K's overrides @ 10M). If the forward-only warm-start must LEARN lateral/backward/turn gaits from scratch, it needs steps WITH the right reward (no standing payoff). Only meaningful if K (5M) shows the gait starts recovering; abort if K/L/M still collapse."}
{"name": "stab-O-nostand-step-10M", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 10000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "rewards.upright_bonus.weight": 0.0, "rewards.stand_walk.params.move_weight": 0.95, "rewards.feet_air_time.weight": 2.5}, "notes": "ANTI-STANDING + stepping drive at LONG budget (M's overrides @ 10M). Same rationale as N; the stronger feet_air_time may be what pushes an omni gait to emerge over 10M. Abort if the 5M anti-standing runs (K/M) still collapse."}
{"name": "stab-P-cur-fwd", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.5], "commands.base_velocity.ranges.lin_vel_y": [0.0, 0.0], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "WIDTH-SWEEP stage 1 (curriculum stopgap while bootstrap --cmd_curriculum is escalated): command range narrowed to FORWARD-ONLY (vx 0-0.5, no lateral/yaw), same 4x tracking reward that collapsed on full omni (G). If the gait HOLDS here (TB ground_speed ~0.4) while G collapsed, it PROVES the collapse is command-width, not reward. Graded on full omni so fitness stays low -> READ TB ground_speed, not the scalar. Builds a forward-tracker ckpt to chain wider from."}
{"name": "stab-Q-cur-lat", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.3, 0.3], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "WIDTH-SWEEP stage 2: forward + LATERAL (vy +-0.3), no backward/yaw. Does the gait survive when lateral is added? Locates the collapse threshold along the lateral axis."}
{"name": "stab-R-cur-back", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [-0.5, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.3, 0.3], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "WIDTH-SWEEP stage 3: add BACKWARD (vx +-0.5) + lateral, no yaw. Backward is the direction the forward-only warm-start most lacks; if collapse starts here, backward is the culprit and the curriculum must ramp vx last."}
{"name": "stab-S-cur-yaw", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [-0.5, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.3, 0.3], "commands.base_velocity.ranges.ang_vel_z": [-0.5, 0.5]}, "notes": "WIDTH-SWEEP stage 4: near-FULL omni (vx+-0.5, vy+-0.3, yaw+-0.5). Should approach G's collapse; brackets the sweep. Together P-S map exactly which command dimensions the warm-start can/can't hold, guiding the curriculum ramp order."}
{"name": "stab-T-cur-mild5M", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.6], "commands.base_velocity.ranges.lin_vel_y": [-0.2, 0.2], "commands.base_velocity.ranges.ang_vel_z": [-0.2, 0.2]}, "notes": "WIDTH-SWEEP @5M: MILDLY-widened range from the known-good walker (fwd vx 0-0.6 + small lateral +-0.2 + small yaw +-0.2), 5M steps. P (fwd-only) tracked (return 74 >> omni 15-49). Does a mild omni widening HOLD tracking from the walker given more steps? If yes, the curriculum's early stages are survivable from a forward base; if no, the curriculum must COMPOUND (chain), reinforcing the --cmd_curriculum escalation."}
{"name": "stab-U-cur-mod5M", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/_preserved/walk_win_0.924_2026-07-24_11-28-07.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [-0.4, 0.6], "commands.base_velocity.ranges.lin_vel_y": [-0.3, 0.3], "commands.base_velocity.ranges.ang_vel_z": [-0.3, 0.3]}, "notes": "WIDTH-SWEEP @5M: MODERATE range (adds backward vx -0.4 + wider lateral/yaw +-0.3) from the walker, 5M. Brackets T. Together T/U show how far the range can widen directly from the walker before tracking collapses -> defines the curriculum ramp steps the engineer's --cmd_curriculum should use."}
{"name": "stab-V-chain-lat", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/tdmpc_biped/2026-07-26_12-54-50/model_best.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.2, 0.2], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "COMPOUNDING CURRICULUM stage 2: warm-start from P's forward-tracker ckpt (idx15, model_best) and add mild LATERAL (vy +-0.2), forward vx 0-0.5, no yaw. THE KEY TEST: does building lateral ON TOP of a working forward gait retain tracking, where widening from the walker directly (Q) degraded (ratio 0.60->0.42)? If V's achieved/commanded ratio stays ~0.6, manual compounding works and I hand-crank the curriculum stage by stage; if V ~= Q, compounding needs the in-run --cmd_curriculum ramp (escalated)."}
{"name": "stab-W-chain-latyaw", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/tdmpc_biped/2026-07-26_12-54-50/model_best.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.2, 0.2], "commands.base_velocity.ranges.ang_vel_z": [-0.2, 0.2]}, "notes": "COMPOUNDING CURRICULUM stage 2b: warm from P's forward-tracker + add lateral (vy+-0.2) AND yaw (+-0.2), forward vx. Brackets V (lateral-only). If both hold from P but degraded from the walker, compounding is confirmed and the next wake chains stage 3 (add backward vx) from V/W's ckpt."}
{"name": "stab-X-chain-back", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/tdmpc_biped/2026-07-26_12-54-50/model_best.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [-0.4, 0.6], "commands.base_velocity.ranges.lin_vel_y": [0.0, 0.0], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "COMPOUNDING stage 2c: chain from P's forward-tracker + add BACKWARD only (vx -0.4..0.6, no lateral/yaw). Backward is the direction the forward warm-start most lacks (R degraded hardest when backward was added directly). Does compounding from a working forward gait let it learn backward where direct widening couldn't?"}
{"name": "stab-Y-chain-full", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/tdmpc_biped/2026-07-26_12-54-50/model_best.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 5000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [-0.4, 0.6], "commands.base_velocity.ranges.lin_vel_y": [-0.2, 0.2], "commands.base_velocity.ranges.ang_vel_z": [-0.2, 0.2]}, "notes": "COMPOUNDING stage 2d: chain from P + near-FULL omni in one step (back+lateral+yaw), 5M. Aggressive: can one long compounding step from a forward base reach near-omni tracking? If V/W/X (single-dimension adds) hold but Y collapses, the curriculum needs SMALL steps (chain dimension by dimension); if Y holds, a forward base + enough steps suffices."}
{"name": "stab-Z1-chain-lat0.1", "entry": "bootstrap.py", "warm_start": "logs/tdmpc/tdmpc_biped/2026-07-26_12-54-50/model_best.pt", "variant": "walk-biped-tdmpc", "max_env_steps": 3000000, "flags": ["--plant", "baseline", "--varied_commands", "--seed_transitions", "200000", "--pretrain_updates", "10000", "--bc_plan_std", "0.3"], "overrides": {"rewards.track_lin_vel_xy.weight": 4.0, "rewards.track_ang_vel_z.weight": 2.0, "commands.base_velocity.ranges.lin_vel_x": [0.0, 0.5], "commands.base_velocity.ranges.lin_vel_y": [-0.1, 0.1], "commands.base_velocity.ranges.ang_vel_z": [0.0, 0.0]}, "notes": "GRANULARITY PROBE: chain from P + TINY lateral (vy +-0.1, half of V's +-0.2). V(+-0.2) degraded to ratio 0.40 == direct-widen Q. Does a SMALLER width step chain cleanly (ratio stays ~0.6)? This is the one thing that distinguishes manual chaining from the in-run --cmd_curriculum ramp (which widens in tiny tracking-gated increments). If +-0.1 holds, fine-grained manual chaining is viable; if it also degrades, ONLY the in-run ramp can work."}
